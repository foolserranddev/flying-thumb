<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FlyingThumbManager</AssemblyName>
    <RootNamespace>FlyingThumbManager</RootNamespace>
    <ApplicationIcon>assets\flying-thumb.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="assets\flying-thumb.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
